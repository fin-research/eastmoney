# Only audited project content enters the public repository.
/*
!/.gitignore
!/.gitleaks.toml
!/.claude-plugin/
!/AGENTS.md
!/README.md
!/package.json
!/pnpm-workspace.yaml
!/pnpm-lock.yaml
!/plugins/
!/vendor/
/vendor/*
!/vendor/xlsx-0.20.3.tgz
!/vendor/xlsx-LICENSE.txt
!/vendor/README.md
!/docs/
!/.github/
!/scripts/
!/gateway/
!/dashboard/
!/data/
!/messenger/
!/ingest/
!/quant/
/scripts/*
!/scripts/ci/
**/node_modules
**/.venv
**/__pycache__/
**/.wrangler/
**/.svelte-kit/
**/.env*
!**/.env.example
**/.dev.vars*
**/.DS_Store
**/.Codex
**/outputs
**/coverage/
