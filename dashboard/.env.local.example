# pnpm dev runs the Worker locally and connects directly to the remote Neon database.
# Keep sslmode=require (or a stricter mode) when using a remote PostgreSQL endpoint.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Permission reads use the same database through the cache-disabled binding.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_AUTHORIZATION_DB=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
