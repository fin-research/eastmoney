{
  "name": "dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local ./node_modules/vite/bin/vite.js --mode dev --host 127.0.0.1 --port 8765",
    "build": "pnpm typecheck && pnpm worker:typecheck && node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
    "preview": "pnpm build && wrangler dev",
    "test": "node --test tests/*.test.mjs tests/financing/*.test.mjs",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:quick": "git diff --check && pnpm typecheck && pnpm worker:typecheck",
    "worker:dev": "pnpm build && wrangler dev",
    "worker:deploy": "node --use-env-proxy scripts/deploy-worker.mjs",
    "worker:status": "node --use-env-proxy scripts/worker-status.mjs",
    "worker:typegen": "node scripts/generate-worker-types.mjs",
    "worker:typecheck": "tsc --project tsconfig.worker.json",
    "bond:db:migrate": "node scripts/apply-bond-migrations.mjs",
    "bond:db:backfill": "node scripts/backfill-bond-ledgers.mjs",
    "financing-model:db:migrate": "node scripts/apply-financing-model-migrations.mjs",
    "credit:db:migrate": "node scripts/apply-credit-migrations.mjs",
    "credit:import": "node --experimental-strip-types scripts/import-credit-workbook.ts",
    "db:sync:remote": "node scripts/sync-remote-d1.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "prepare": "svelte-kit sync",
    "test:financing": "node --test tests/financing/*.test.mjs",
    "financing:db:init": "node --env-file-if-exists=.env --env-file-if-exists=.env.database scripts/financing/init-database.mjs",
    "financing:db:import": "node --env-file-if-exists=.env --env-file-if-exists=.env.database scripts/financing/import-debts.mjs",
    "financing:db:migrate:sqlite": "node --env-file-if-exists=.env --env-file-if-exists=.env.database scripts/financing/migrate-sqlite-to-postgres.mjs",
    "financing:reminders:send": "node --env-file-if-exists=.env --env-file-if-exists=.env.database scripts/financing/send-reminders.mjs",
    "verify:routes": "node scripts/verify-profile-routes.mjs && node scripts/verify-financing-routes.mjs",
    "auth:db:migrate": "node --env-file-if-exists=.env.local scripts/apply-unified-permissions.mjs",
    "test:auth": "node --test tests/authorization-access.test.mjs tests/unified-permissions.test.mjs tests/access.test.mjs tests/programmatic-login.test.mjs tests/auth0-deploy.test.mjs",
    "auth:verify": "node --use-env-proxy scripts/verify-auth-access.mjs",
    "auth0:export": "node --use-env-proxy scripts/auth0-deploy.mjs export",
    "auth0:plan": "node --use-env-proxy scripts/auth0-deploy.mjs plan",
    "auth0:apply": "node --use-env-proxy scripts/auth0-deploy.mjs apply",
    "test:coverage": "mkdir -p coverage && node --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-include='src/**/*.js' --test-coverage-exclude='src/**/generated/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test tests/*.test.mjs tests/financing/*.test.mjs",
    "test:visual": "playwright test",
    "visual:local": "node scripts/visual-linux.mjs",
    "visual:baseline:import-local": "node scripts/import-local-visual.mjs",
    "direct:push": "node scripts/direct-push.mjs",
    "test:visual:update": "playwright test --update-snapshots=all",
    "test:visual:report": "playwright show-report",
    "test:python": "uv run tests/test_credit_materials.py",
    "check:visual-coverage": "node scripts/check-visual-coverage.mjs",
    "visual:baseline:import": "node scripts/visual-baselines.mjs import",
    "test:ci-tools": "node --test scripts/tests/*.test.mjs",
    "build:visual": "vite build --config vite.visual.config.mjs && node scripts/prepare-visual-build.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.118",
    "@auth0/auth0-spa-js": "2.28.2",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "^1.27.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@noble/hashes": "^2.3.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.2",
    "@tanstack/svelte-table": "9.1.2",
    "@xyflow/svelte": "^1.6.6",
    "agents": "^0.22.0",
    "ai": "^6.0.291",
    "bits-ui": "2.19.2",
    "clsx": "2.1.1",
    "d3-cloud": "^1.2.9",
    "decimal.js": "^10.6.0",
    "devalue": "5.8.2",
    "echarts": "^6.0.0",
    "exceljs": "4.4.0",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.12",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.0",
    "pinyin-pro": "^3.29.4",
    "svelte": "5.56.8",
    "svelte-sonner": "1.2.1",
    "sveltekit-superforms": "^2.30.2",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260823.1",
    "@electric-sql/pglite": "^0.3.12",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-cloud": "^1.2.9",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "auth0-deploy-cli": "^8.44.0",
    "better-sqlite3": "^13.0.1",
    "happy-dom": "^20.14.0",
    "shadcn-svelte": "1.6.1",
    "svelte-check": "^4.7.4",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wrangler": "4.125.0"
  }
}
