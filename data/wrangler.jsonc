{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eastmoney-data",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "routes": [],
  "ratelimits": [
    { "name": "CHOICE_FAST_LIMIT", "namespace_id": "915001", "simple": { "limit": 10000, "period": 60 } },
    { "name": "CHOICE_OTHER_LIMIT", "namespace_id": "915002", "simple": { "limit": 10, "period": 60 } },
    { "name": "DM_LIMIT", "namespace_id": "915003", "simple": { "limit": 600, "period": 60 } },
    { "name": "EASTMONEY_LIMIT", "namespace_id": "915004", "simple": { "limit": 120, "period": 60 } },
    { "name": "CHINAMONEY_LIMIT", "namespace_id": "915005", "simple": { "limit": 60, "period": 60 } },
    { "name": "CAMEL_LIMIT", "namespace_id": "915006", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "5cecc63c78acf8f5473f8745f4244448",
    "AI_GATEWAY_ID": "default"
  },
  "vpc_services": [
    {
      "binding": "DM",
      "service_id": "01a04e23-e6ae-77b2-9634-8652d2afd57c",
      "remote": true
    },
    {
      "binding": "CHOICE_RPC",
      "service_id": "01a04e4c-db9a-74e0-92f5-09c19c03adc4",
      "remote": true
    },
    {
      "binding": "CAMEL",
      "service_id": "01a06116-3a02-77f3-9405-cea8b5c950c9",
      "remote": true
    }
  ],
  "secrets": {
    "required": [
      "DM_COOKIE",
      "CHOICE_RPC_TOKEN",
      "CF_AIG_TOKEN",
      "CAMEL_USERNAME",
      "CAMEL_PASSWORD"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.25,
      "persist": true
    }
  },
  "preview_urls": false,
  "workflows": [
    {
      "binding": "ECONOMIC_INDICATOR_SYNC",
      "name": "economic-indicator-sync",
      "class_name": "EconomicIndicatorSyncWorkflow"
    },
    {
      "binding": "DM_FUNDING_SYNC",
      "name": "dm-funding-sync",
      "class_name": "DmFundingSyncWorkflow"
    }
  ],
  "triggers": {
    "crons": []
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "c785e7ee2cc54a278dd4b2f0e561a6f9"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EASTMONEY",
      "bucket_name": "eastmoney",
      "remote": true
    }
  ]
}
