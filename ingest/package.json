{
  "name": "eastmoney-ingest",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "wrangler types --check && tsc --noEmit",
    "test": "vitest run",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy:worker": "wrangler deploy",
    "test:auth": "vitest run tests/access.test.ts tests/data-fetcher.test.ts",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "dependencies": {
    "mdast-util-from-markdown": "catalog:",
    "zod": "catalog:"
  }
}
