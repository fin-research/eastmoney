{
  "name": "eastmoney-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "wrangler dev",
    "typegen": "wrangler types && node scripts/normalize-generated-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm typegen && pnpm typecheck && pnpm test",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "auth:verify": "node --use-env-proxy scripts/verify-auth-access.mjs",
    "auth0:export": "node --use-env-proxy scripts/auth0-deploy.mjs export",
    "auth0:plan": "node --use-env-proxy scripts/auth0-deploy.mjs plan",
    "auth0:apply": "node --use-env-proxy scripts/auth0-deploy.mjs apply",
    "test:coverage": "mkdir -p coverage && node --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-include='src/**/*.js' --test-coverage-exclude='src/**/generated/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.22.0",
    "graphql": "16.11.0",
    "hono": "4.13.5",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "auth0-deploy-cli": "^8.44.0",
    "typescript": "^5.9.0",
    "wrangler": "4.127.1"
  }
}
