{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eastmoney-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_request_signal"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "eastmoney.hasbai.xyz/*",
      "zone_name": "hasbai.xyz"
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://eastmoney.hasbai.xyz",
    "CLOUDFLARE_ACCOUNT_ID": "5cecc63c78acf8f5473f8745f4244448",
    "AI_GATEWAY_ID": "default",
    "AUTH0_DOMAIN": "hasbai.eu.auth0.com",
    "AUTH0_LOGIN_DOMAIN": "auth.hasbai.xyz",
    "AUTH0_CLIENT_ID": "16vMxoYpr5AdPRiW1PkwIiHuRWszii6m",
    "AUTH0_ORGANIZATION_ID": "org_6yvoRRCkzk3eGkBS",
    "AUTH0_AUDIENCE": "https://eastmoney.hasbai.xyz/",
    "AUTH0_MANAGEMENT_CLIENT_ID": "LA46CcB3FQ4Uac4JyEzPSObcV4PV8CFU",
    "AUTHORIZATION_MODE": "enforce",
    "AUTH0_MACHINE_CLIENT_IDS": ""
  },
  "secrets": {
    "required": [
      "AUTH0_MANAGEMENT_CLIENT_SECRET",
      "CF_AIG_TOKEN"
    ]
  },
  "services": [
    {
      "binding": "QUANT_REPORT",
      "service": "quant",
      "entrypoint": "ResearchReport"
    },
    {
      "binding": "DASHBOARD",
      "service": "eastmoney-dashboard",
      "entrypoint": "GatewayDashboard"
    },
    {
      "binding": "DATA",
      "service": "eastmoney-data",
      "entrypoint": "GatewayData"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.25,
      "persist": true
    }
  }
}
